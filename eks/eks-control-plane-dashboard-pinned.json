          [
            "AWS/EKS",
            "apiserver_request_total",
            "ClusterName",
            "placeholder",
            {
              "stat": "Sum"
            }
          ]
        ],
        "region": "us-east-1",
        "period": 300,
        "title": "Requests"
      }
    },
    {
      "type": "metric",
      "x": 8,
