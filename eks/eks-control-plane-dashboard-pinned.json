{
  "variables": [
    {
      "type": "property",
      "property": "region",
      "inputType": "input",
      "id": "region",
      "label": "Region",
      "visible": false,
      "defaultValue": "us-east-1"
    },
    {
      "type": "property",
      "property": "ClusterName",
      "inputType": "select",
      "id": "cluster",
      "label": "Cluster Name",
      "visible": true,
      "values": [
        { "value": "cluster-a" },
        { "value": "cluster-b" }
      ],
      "defaultValue": "cluster-a"
    }
  ],
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# Amazon EKS - Control Plane Metrics (Pinned Clusters)\n⚠️ All listed clusters must be in the same region (set by the hidden `region` variable). Node charts require the **CloudWatch Observability EKS add-on** (Container Insights)."
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 2,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "## 🖥️ Node Overview - Selected Cluster\nWorker node count and failed node count of the selected cluster."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 4,
      "width": 12,
      "height": 6,
      "properties": {
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          [
            "ContainerInsights",
            "cluster_node_count",
            "ClusterName",
            "placeholder",
            {
              "stat": "Average"
            }
          ]
        ],
        "region": "us-east-1",
        "period": 300,
        "title": "Node Count"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 4,
      "width": 12,
      "height": 6,
      "properties": {
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          [
            "ContainerInsights",
            "cluster_failed_node_count",
            "ClusterName",
            "placeholder",
            {
              "stat": "Average"
            }
          ]
        ],
        "region": "us-east-1",
        "period": 300,
        "title": "Failed Node Count"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 10,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "## 📍 Control Plane - Selected Cluster"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 8,
      "height": 6,
